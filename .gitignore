*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints
notebooks/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Virtual environments
.env
venv/
env/
.venv/

