# ============================================
# AuroraGate — Context & Git Exclusions
# ============================================

# داده‌های خام (سنگین، نباید وارد context یا git شوند)
data/*.csv
data/*.zip

# خروجی‌های پردازش‌شده
processed_data/
submissions/

# مدل‌های ذخیره‌شده (binary)
models/*.pkl
models/*.cbm
models/*.bin

# CatBoost logs
catboost_info/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Virtual environments
.env
venv/
env/
.venv/

# Optuna storage
*.db
optuna_study*

# Temp files
*.log
*.tmp
*.temp
scratch/*.csv
scratch/*.pkl

# IDE
.DS_Store
.idea/
.vscode/
